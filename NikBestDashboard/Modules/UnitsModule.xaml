<UserControl x:Class="NikBestDashboard.Modules.UnitsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="📊 Юниты" FontSize="24" FontWeight="Bold" Foreground="#EEEEFF" Margin="0,0,0,15"/>

        <!-- Фильтры и поиск -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,15" VerticalAlignment="Center">
            <TextBlock Text="Фильтр:" Foreground="#CCCCDD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            
            <ComboBox x:Name="GameFilterComboBox" Width="120" Margin="0,0,10,0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Все игры" IsSelected="True"/>
            </ComboBox>

            <ComboBox x:Name="CategoryFilterComboBox" Width="120" Margin="0,0,10,0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Все категории" IsSelected="True"/>
                <ComboBoxItem Content="Моб"/>
                <ComboBoxItem Content="Босс"/>
                <ComboBoxItem Content="NPC"/>
                <ComboBoxItem Content="Герой"/>
            </ComboBox>

            <TextBox x:Name="SearchTextBox" Width="150" Text="Поиск..." Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="5" FontSize="14" 
                     GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" TextChanged="SearchTextBox_TextChanged"/>
        </WrapPanel>

        <!-- Форма добавления -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="NameTextBox" Grid.Column="0" Text="Имя юнита..." Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="10" FontSize="14" VerticalContentAlignment="Center"
                     GotFocus="NameTextBox_GotFocus" LostFocus="NameTextBox_LostFocus"/>

            <TextBox x:Name="GameTextBox" Grid.Column="1" Width="100" Margin="10,0,0,0" Text="Игра..." Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="10" FontSize="14" VerticalContentAlignment="Center"
                     GotFocus="GameTextBox_GotFocus" LostFocus="GameTextBox_LostFocus"/>

            <ComboBox x:Name="CategoryComboBox" Grid.Column="2" Width="100" Margin="10,0,0,0">
                <ComboBoxItem Content="Моб" IsSelected="True"/>
                <ComboBoxItem Content="Босс"/>
                <ComboBoxItem Content="NPC"/>
                <ComboBoxItem Content="Герой"/>
            </ComboBox>

            <TextBox x:Name="HealthTextBox" Grid.Column="3" Width="60" Margin="10,0,0,0" Text="HP" Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="5" FontSize="14" TextAlignment="Center"
                     GotFocus="HealthTextBox_GotFocus" LostFocus="HealthTextBox_LostFocus"/>

            <TextBox x:Name="AttackTextBox" Grid.Column="4" Width="60" Margin="5,0,0,0" Text="ATK" Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="5" FontSize="14" TextAlignment="Center"
                     GotFocus="AttackTextBox_GotFocus" LostFocus="AttackTextBox_LostFocus"/>

            <Button Grid.Column="5" Content="➕ Добавить" Click="AddItem_Click" Background="#7C4DFF" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Список юнитов -->
        <ListBox x:Name="UnitsListBox" Grid.Row="3" Background="#2A2A3E" BorderBrush="#444466" BorderThickness="1" Foreground="#EEEEFF" FontSize="14">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#3A3A52" CornerRadius="6" Padding="10" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="#EEEEFF" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding Category}" Foreground="#C9B1FF" FontSize="12" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Game}" Foreground="#8888AA" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Health, StringFormat='❤ {0}'}" Foreground="#E53935" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Attack, StringFormat='⚔ {0}'}" Foreground="#FF8A65" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Defense, StringFormat='🛡 {0}'}" Foreground="#4FC3F7" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding AttackType}" Foreground="#8888AA" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#8888AA" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <Button Grid.Column="2" Content="🗑️" Click="DeleteItem_Click" Tag="{Binding Id}" Background="Transparent" BorderThickness="0" Foreground="#E53935" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>