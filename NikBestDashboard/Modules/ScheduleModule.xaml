<UserControl x:Class="NikBestDashboard.Modules.ScheduleModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📅 Планировщик видео" FontSize="24" FontWeight="Bold" Foreground="#EEEEFF" Margin="0,0,0,5"/>

        <!-- Статистика -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📅 Всего:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="ScheduleTotal" Text="0" Foreground="#EEEEFF" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📝 В планах:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="SchedulePlanned" Text="0" Foreground="#FFA726" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄 В работе:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="ScheduleWork" Text="0" Foreground="#7C4DFF" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅ Готово:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="ScheduleDone" Text="0" Foreground="#4CAF50" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚀 Опубликовано:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="SchedulePublished" Text="0" Foreground="#4FC3F7" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Фильтр -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,15" VerticalAlignment="Center">
            <TextBlock Text="Фильтр:" Foreground="#CCCCDD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="StatusFilterComboBox" Width="140" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                <ComboBoxItem Content="В планах"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Готово"/>
                <ComboBoxItem Content="Опубликовано"/>
            </ComboBox>
        </WrapPanel>

        <!-- Форма добавления -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleTextBox" Grid.Column="0" Text="Название видео..." Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="10" FontSize="14" VerticalContentAlignment="Center"
                     GotFocus="TitleTextBox_GotFocus" LostFocus="TitleTextBox_LostFocus"/>
            <ComboBox x:Name="StatusComboBox" Grid.Column="1" Width="130" Margin="10,0,0,0">
                <ComboBoxItem Content="В планах" IsSelected="True"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Готово"/>
                <ComboBoxItem Content="Опубликовано"/>
            </ComboBox>
            <Button Grid.Column="2" Content="➕ Добавить" Click="AddItem_Click" Background="#7C4DFF" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Список видео -->
        <ListBox x:Name="ScheduleListBox" Grid.Row="4" Background="#2A2A3E" BorderBrush="#444466" BorderThickness="1" Foreground="#EEEEFF" FontSize="14">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#3A3A52" CornerRadius="6" Padding="10" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" Foreground="#EEEEFF" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Date, StringFormat='dd.MM.yyyy'}" Foreground="#8888AA" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#C9B1FF" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Grid.Column="2" Content="⬆" Click="ChangeStatus_Click" Tag="{Binding Id}" Background="Transparent" BorderThickness="0" Foreground="#8888AA" Cursor="Hand" Margin="0,0,5,0" ToolTip="Следующий статус"/>
                            <Button Grid.Column="3" Content="🗑️" Click="DeleteItem_Click" Tag="{Binding Id}" Background="Transparent" BorderThickness="0" Foreground="#E53935" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>