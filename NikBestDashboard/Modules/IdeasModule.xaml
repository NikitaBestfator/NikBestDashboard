<UserControl x:Class="NikBestDashboard.Modules.IdeasModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + статистика -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="📝 Трекер идей" FontSize="24" FontWeight="Bold" Foreground="#EEEEFF"/>
            <TextBlock x:Name="StatsText" FontSize="16" Foreground="#8888AA" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Статистика -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📌 Всего:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="TotalCount" Text="0" Foreground="#EEEEFF" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟢 Активных:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="ActiveCount" Text="0" Foreground="#4CAF50" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄 В работе:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="WorkCount" Text="0" Foreground="#FFA726" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅ Готово:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="DoneCount" Text="0" Foreground="#4CAF50" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦 Архив:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="ArchivedCount" Text="0" Foreground="#8888AA" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Панель фильтров -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,15" VerticalAlignment="Center">
            <TextBlock Text="Фильтр:" Foreground="#CCCCDD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
    
            <ComboBox x:Name="CategoryFilterComboBox" Width="140" Margin="0,0,10,0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Все категории" IsSelected="True"/>
                <ComboBoxItem Content="Битвы"/>
                <ComboBoxItem Content="Постройки"/>
                <ComboBoxItem Content="Топы и списки"/>
                <ComboBoxItem Content="Эксперименты"/>
                <ComboBoxItem Content="Игры"/>
                <ComboBoxItem Content="Моды и код"/>
                <ComboBoxItem Content="Челленджи"/>
                <ComboBoxItem Content="Викторина"/>
                <ComboBoxItem Content="Код"/>
                <ComboBoxItem Content="Бравл Старс"/>
                <ComboBoxItem Content="TABS"/>
                <ComboBoxItem Content="Roblox"/>
            </ComboBox>

            <ComboBox x:Name="StatusFilterComboBox" Width="120" Margin="0,0,10,0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                <ComboBoxItem Content="В планах"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Готово"/>
                <ComboBoxItem Content="Опубликовано"/>
            </ComboBox>

            <Button Content="🎲 Случайная идея" Click="RandomIdea_Click" Background="#7C4DFF" Foreground="White" FontWeight="Bold" Padding="12,5" BorderThickness="0" Cursor="Hand"/>
        </WrapPanel>

        <!-- Форма добавления -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TitleTextBox" Grid.Column="0" 
                     Text="Новая идея..." 
                     Foreground="#888888" 
                     Background="#2A2A3E" 
                     BorderBrush="#444466" 
                     Padding="10" 
                     FontSize="14" 
                     VerticalContentAlignment="Center"
                     GotFocus="TitleTextBox_GotFocus"
                     LostFocus="TitleTextBox_LostFocus"
                     IsHitTestVisible="True"/>

            <ComboBox x:Name="CategoryComboBox" Grid.Column="1" Width="110" Margin="10,0,0,0">
                <ComboBoxItem Content="Битвы" IsSelected="True"/>
                <ComboBoxItem Content="Лаборатория"/>
                <ComboBoxItem Content="Код"/>
                <ComboBoxItem Content="Другое"/>
            </ComboBox>

            <ComboBox x:Name="PriorityComboBox" Grid.Column="2" Width="100" Margin="10,0,0,0">
                <ComboBoxItem Content="Высокий" IsSelected="True"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Низкий"/>
            </ComboBox>

            <ComboBox x:Name="StatusComboBox" Grid.Column="3" Width="110" Margin="10,0,0,0">
                <ComboBoxItem Content="В планах" IsSelected="True"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Готово"/>
                <ComboBoxItem Content="Опубликовано"/>
            </ComboBox>

            <Button Grid.Column="4" Content="➕ Добавить" Click="AddIdea_Click" Background="#7C4DFF" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Список идей -->
        <ListBox x:Name="IdeasListBox" Grid.Row="4" Background="#2A2A3E" BorderBrush="#444466" BorderThickness="1" Foreground="#EEEEFF" FontSize="14">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#3A3A52" CornerRadius="6" Padding="10" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" Foreground="#EEEEFF" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Category}" Foreground="#8888AA" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Priority}" Foreground="#8888AA" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Foreground="#666688" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#C9B1FF" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <!-- Кнопка закрепления -->
                            <Button Grid.Column="2" Content="📌" Click="PinIdea_Click" Tag="{Binding Id}" 
                                    Background="Transparent" BorderThickness="0" 
                                    Foreground="{Binding IsPinned, Converter={StaticResource PinColorConverter}}" 
                                    Cursor="Hand" Margin="0,0,5,0" ToolTip="Закрепить"/>

                            <!-- Кнопка редактирования -->
                            <Button Grid.Column="3" Content="✏️" Click="EditIdea_Click" Tag="{Binding Id}" 
                                    Background="Transparent" BorderThickness="0" Foreground="#8888AA" Cursor="Hand" Margin="0,0,5,0"/>

                            <!-- Кнопка удаления -->
                            <Button Grid.Column="4" Content="🗑️" Click="DeleteIdea_Click" Tag="{Binding Id}" 
                                    Background="Transparent" BorderThickness="0" Foreground="#E53935" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>