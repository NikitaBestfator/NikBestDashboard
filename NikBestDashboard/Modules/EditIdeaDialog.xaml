<Window x:Class="NikBestDashboard.Modules.EditIdeaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✏️ Редактирование идеи" Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">
    <Window.Resources>

        <!-- ===== СТИЛЬ ДЛЯ COMBOBOX (ИЗ ВИКТОРИНЫ — РАБОЧИЙ) ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#555577"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="✏️ Редактирование идеи" FontSize="20" FontWeight="Bold" Foreground="#EEEEFF" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Название:" Foreground="#CCCCDD" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="2" Background="#2A2A3E" Foreground="White" BorderBrush="#444466" Padding="10" FontSize="14" Margin="0,0,0,10"/>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Категория:" Foreground="#CCCCDD" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <!-- УБРАНЫ ЯВНЫЕ ЭЛЕМЕНТЫ! -->
                <ComboBox x:Name="CategoryComboBox" FontSize="14" Height="32"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Приоритет:" Foreground="#CCCCDD" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="PriorityComboBox" FontSize="14" Height="32"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Статус:" Foreground="#CCCCDD" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="StatusComboBox" FontSize="14" Height="32"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="💾 Сохранить" Click="SaveButton_Click" Background="#7C4DFF" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0" Cursor="Hand" Width="100"/>
            <Button Content="❌ Отмена" Click="CancelButton_Click" Background="#444466" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0" Cursor="Hand" Width="100" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>