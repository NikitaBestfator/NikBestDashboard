<UserControl x:Class="NikBestDashboard.Modules.TitlesModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📋 Текст для видео" FontSize="24" FontWeight="Bold" Foreground="#EEEEFF" Margin="0,0,0,5"/>

        <!-- Статистика -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋 Всего:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="TextTotal" Text="0" Foreground="#EEEEFF" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📌 Названий:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="TextTitles" Text="0" Foreground="#7C4DFF" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖼️ Обложек:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="TextCovers" Text="0" Foreground="#4FC3F7" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2A2A3E" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" BorderBrush="#444466" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⭐ Избранное:" Foreground="#8888AA" FontSize="12"/>
                    <TextBlock x:Name="TextFavorites" Text="0" Foreground="#FFD700" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Генерация -->
        <Border Grid.Row="2" Background="#2A2A3E" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#444466" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🎯 Генерация текста" Foreground="#CCCCDD" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TopicTextBox" Grid.Column="0" Text="Введите тему..." Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="10" FontSize="14" VerticalContentAlignment="Center"
                             GotFocus="TopicTextBox_GotFocus" LostFocus="TopicTextBox_LostFocus"/>
                    <ComboBox x:Name="TypeComboBox" Grid.Column="1" Width="130" Margin="10,0,0,0">
                        <ComboBoxItem Content="Название" IsSelected="True"/>
                        <ComboBoxItem Content="Обложка"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="✨ Сгенерировать" Click="Generate_Click" Background="#7C4DFF" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="📊 Анализ" Click="AnalyzeTitle_Click" Background="#444466" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="5,0,0,0" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Шаблоны -->
        <Border Grid.Row="3" Background="#2A2A3E" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#444466" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📋 Шаблоны заголовков" Foreground="#CCCCDD" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="⚔️ Битва" Click="ApplyTemplate_Click" Tag="Битва" Background="#3A3A52" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,5,5"/>
                    <Button Content="🔥 Челлендж" Click="ApplyTemplate_Click" Tag="Челлендж" Background="#3A3A52" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,5,5"/>
                    <Button Content="🏆 ТОП" Click="ApplyTemplate_Click" Tag="ТОП" Background="#3A3A52" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,5,5"/>
                    <Button Content="🧪 Эксперимент" Click="ApplyTemplate_Click" Tag="Эксперимент" Background="#3A3A52" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,5,5"/>
                    <Button Content="📝 Обзор" Click="ApplyTemplate_Click" Tag="Обзор" Background="#3A3A52" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,5,5"/>
                    <Button Content="🎮 Игры" Click="ApplyTemplate_Click" Tag="Игры" Background="#3A3A52" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,5,5"/>
                    <Button Content="💻 Код" Click="ApplyTemplate_Click" Tag="Код" Background="#3A3A52" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,5,5"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Результаты -->
        <Border Grid.Row="4" Background="#2A2A3E" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#444466" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="💡 Варианты" Foreground="#CCCCDD" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ListBox x:Name="GeneratedListBox" Background="#2A2A3E" BorderBrush="#444466" BorderThickness="0" Foreground="#EEEEFF" FontSize="14" MaxHeight="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#3A3A52" CornerRadius="6" Padding="8" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" Foreground="#EEEEFF" FontSize="13" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="💾" Click="SaveGenerated_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#4CAF50" Cursor="Hand" Margin="0,0,5,0" ToolTip="Сохранить"/>
                                    <Button Grid.Column="2" Content="📋" Click="CopyGenerated_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#7C4DFF" Cursor="Hand" ToolTip="Копировать"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoResultsText" Text="Введите тему и нажмите «Сгенерировать» или выберите шаблон" Foreground="#666688" FontSize="13" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Библиотека -->
        <Border Grid.Row="5" Background="#2A2A3E" CornerRadius="10" Padding="15" BorderBrush="#444466" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📚 Библиотека" Foreground="#CCCCDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" Width="150" Margin="15,0,0,0" Text="Поиск..." Foreground="#888888" Background="#2A2A3E" BorderBrush="#444466" Padding="5" FontSize="13"
                             GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>
                <ListBox x:Name="LibraryListBox" Grid.Row="1" Background="#2A2A3E" BorderBrush="#444466" BorderThickness="0" Foreground="#EEEEFF" FontSize="13">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#3A3A52" CornerRadius="6" Padding="10" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Text}" Foreground="#EEEEFF" FontSize="14" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Type}" Foreground="#C9B1FF" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Topic}" Foreground="#8888AA" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Foreground="#666688" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⭐" Click="ToggleFavorite_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#FFD700" Cursor="Hand" Margin="0,0,5,0" ToolTip="В избранное"/>
                                    <Button Grid.Column="2" Content="📋" Click="CopyLibrary_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#7C4DFF" Cursor="Hand" Margin="0,0,5,0" ToolTip="Копировать"/>
                                    <Button Grid.Column="3" Content="🗑️" Click="DeleteLibrary_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#E53935" Cursor="Hand" ToolTip="Удалить"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>