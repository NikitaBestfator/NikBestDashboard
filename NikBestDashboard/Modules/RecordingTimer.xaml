<Window x:Class="NikBestDashboard.Modules.RecordingTimer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⏱️ Таймер записи видео" Height="450" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="⏱️ Таймер записи видео" FontSize="22" FontWeight="Bold" Foreground="#EEEEFF" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Выбор времени -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="Время:" Foreground="#CCCCDD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="TimeComboBox" Width="120" Background="White" Foreground="Black" BorderBrush="#555577" FontSize="14" Height="30" SelectedIndex="0">
                <ComboBoxItem Content="1 минута" Tag="60"/>
                <ComboBoxItem Content="3 минуты" Tag="180"/>
                <ComboBoxItem Content="5 минут" Tag="300"/>
                <ComboBoxItem Content="10 минут" Tag="600"/>
            </ComboBox>
        </StackPanel>

        <!-- Таймер -->
        <Border Grid.Row="2" Background="#2A2A3E" CornerRadius="12" Padding="20" Margin="0,0,0,10" BorderBrush="#444466" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MinutesDisplay" Grid.Column="0" Text="00" FontSize="72" FontWeight="Bold" Foreground="#EEEEFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text=":" FontSize="72" FontWeight="Bold" Foreground="#666688" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>

                <TextBlock x:Name="SecondsDisplay" Grid.Column="2" Text="00" FontSize="72" FontWeight="Bold" Foreground="#EEEEFF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Статус -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Готов к записи" Foreground="#8888AA" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,15" Height="30" VerticalAlignment="Center"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0" VerticalAlignment="Top">
            <Button x:Name="StartButton" Content="▶️ Старт" Click="StartTimer_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
            <Button x:Name="PauseButton" Content="⏸️ Пауза" Click="PauseTimer_Click" Background="#FFA726" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="ResetButton" Content="🔄 Сброс" Click="ResetTimer_Click" Background="#444466" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="✖ Закрыть" Click="CloseButton_Click" Background="#E53935" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>